#!/usr/bin/env bash
# post-commit — a commit is the finished signal, so a commit that touched the plugin, the engine,
# a hook or the installer installs itself (Dave, 2026-09-21: "Please auto update always upon
# unlock"). install.sh writes nothing the shell loads while the screen is locked or Barbarian's
# panel is open (the layout engines and its own hidden-widget list may change under a lock, since
# nothing reloads them), and arms a waiter that finishes the job the moment that clears, so this
# is safe at any hour.
#
# On the machine that owns the mirror ships the same commit also goes to them through the machine
# repo's ship-sync service, which rsyncs this repo alongside the private machine repo and
# re-runs setup-portable on each ship. ⚠️ THE MACHINE NAMES LIVE IN hooks/ships.local — a local,
# uncommitted file — because they are private and stay out of this public repository: the 10 Nov
# 2026 name scrub had to de-prose them here, and a scrub must never be able to break running
# code again. ships.local defines SHIP_HOST (the owning machine's hostname), MACHINE_GIT (the
# machine repo's .git) and SHIPS (the ship hostnames). Without the file, or anywhere else, this
# half is a no-op.
HERE="$(git rev-parse --show-toplevel 2>/dev/null)"
git diff-tree --no-commit-id --name-only -r -m HEAD 2>/dev/null \
  | grep -q -E '^(plugin/|engine/|hooks/|install\.sh$)' || exit 0

[ -n "$HERE" ] && [ -x "$HERE/install.sh" ] && "$HERE/install.sh"

[ -r "$HERE/hooks/ships.local" ] && . "$HERE/hooks/ships.local"
[ -n "${SHIP_HOST:-}" ] && [ "$(hostname)" = "$SHIP_HOST" ] || exit 0
[ -n "${MACHINE_GIT:-}" ] && [ -d "$MACHINE_GIT" ] || exit 0
for ship in ${SHIPS:-}; do
  systemctl --user start --no-block "ship-sync@$ship.service" 2>/dev/null || true
done
exit 0
