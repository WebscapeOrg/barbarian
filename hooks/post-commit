#!/usr/bin/env bash
# post-commit — a commit here that touched the plugin or the engine pushes it to the
# mirror ships (the MacBook, the backup machine) through the machine repo's ship-sync service, which
# rsyncs this repo alongside the private machine repo and re-runs setup-portable on each
# ship. SER8 only: everywhere else this is a no-op.
[ "$(hostname)" = the-main-machine ] || exit 0
[ -d "the machine repo's checkout/.git" ] || exit 0
git diff-tree --no-commit-id --name-only -r -m HEAD 2>/dev/null \
  | grep -q -E '^(plugin/|engine/|install\.sh$)' || exit 0
for ship in the MacBook the backup machine; do
  systemctl --user start --no-block "ship-sync@$ship.service" 2>/dev/null || true
done
exit 0
