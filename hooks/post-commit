#!/usr/bin/env bash
# post-commit — a commit is the finished signal, so a commit that touched the plugin, the engine,
# a hook or the installer installs itself (Dave, 2026-09-21: "Please auto update always upon
# unlock"). install.sh writes nothing the shell loads while the screen is locked or Barbarian's
# panel is open (the layout engines and its own hidden-widget list may change under a lock, since
# nothing reloads them), and arms a waiter that finishes the job the moment that clears, so this
# is safe at any hour.
#
# On the machine that owns the mirror ships the same commit also goes to them (the MacBook, the backup machine)
# through the machine repo's ship-sync service, which rsyncs this repo alongside
# the private machine repo and re-runs setup-portable on each ship. SER8 only: everywhere else that
# half is a no-op.
HERE="$(git rev-parse --show-toplevel 2>/dev/null)"
git diff-tree --no-commit-id --name-only -r -m HEAD 2>/dev/null \
  | grep -q -E '^(plugin/|engine/|hooks/|install\.sh$)' || exit 0

[ -n "$HERE" ] && [ -x "$HERE/install.sh" ] && "$HERE/install.sh"

[ "$(hostname)" = the-main-machine ] || exit 0
[ -d "the machine repo's checkout/.git" ] || exit 0
for ship in the MacBook the backup machine; do
  systemctl --user start --no-block "ship-sync@$ship.service" 2>/dev/null || true
done
exit 0
