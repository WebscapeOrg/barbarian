#!/usr/bin/env bash
# bar-arrange-apply <L|C|R>:<widget-id>[:hidden]... [WS:<id>:<left|center|right>] [DEL:<widget-id>]...
# Rewrite the LEFT, CENTER and RIGHT sections of ~/.config/omarchy/shell.json to the
# given order, park ids marked :hidden in ~/.config/omarchy/bar-hidden.json, and place
# the workspaces strip per the WS directive. Two lanes since 2026-09-01 (Dave asked for
# icons on the far left); hiding since the same day (Dave: Bluetooth is "noise/clutter
# 99% of the time but occasionally I want" — a hidden entry is MOVED to the sidecar with
# its whole settings object, its lane and its position, never deleted). A hidden service,
# panel or overlay also keeps its id in top-level plugins[], so hiding its icon does not
# unload the app; the CENTER lane and the WS directive since the same evening
# (Barbarian's mode toggle: the strip goes
# far left, centre, or far right — "off" was briefly a mode and turned out to be a typo).
#
# DEL:<widget-id> (since 2026-09-28) removes an entry outright, wherever it sits — a lane,
# the sidecar or plugins[] — and is how a plugin's uninstall leaves the bar (bin/plugin-uninstall
# trashes the folder itself, detached; this script stays the only writer of these files).
# DEL:omarchy.spacer keeps the older count-based meaning: spacers are fungible, so the
# panel sends one directive per removed spacer.
#
# Entries travel as whole objects, so per-widget settings (the clock's formats, the
# strip's own config) survive a reorder, a lane change and a hide/show round-trip. Ids
# in the file but not in the arguments (the invisible atlas.arrange widget itself)
# keep their place at the end of the lane they were already in. Without a WS directive
# (a stale pre-mode panel) the strip simply stays where it is. Writes are tmp+rename,
# so a crash mid-write cannot half-eat the bar.
#
# Refuses rather than guesses: an argument that names no current entry (any lane or the
# sidecar), or names one twice, aborts with both files unchanged.
#
# ⚠️ ONE WRITER AT A TIME (2026-11-03). The panel is not the only caller: another plugin's
# uninstaller sends DEL:<its id> (Magpie Calendar's, hobnob #7398). Each run reads both files and
# writes them back, so two runs at once would let the later one put back what the earlier took
# out. A lock beside the files makes the second run wait its turn and read what the first wrote.
set -euo pipefail
exec 9>"$HOME/.config/omarchy/.bar-arrange-apply.lock"
flock 9
# exec, so a caller that kills only the process it started (Python's subprocess timeout does)
# stops the one doing the work, not a parent that leaves its child writing (hobnob #7403). The
# lock stays held on fd 9.
exec python3 - "$@" <<'PY'
import json, os, sys, tempfile

path = os.path.expanduser("~/.config/omarchy/shell.json")
side = os.path.expanduser("~/.config/omarchy/bar-hidden.json")
if not sys.argv[1:]:
    sys.exit("bar-arrange-apply: no ids given")
repair_hidden = sys.argv[1:] in (["--repair-hidden"], ["--repair-hidden", "--check"])
repair_check = sys.argv[1:] == ["--repair-hidden", "--check"]
if "--repair-hidden" in sys.argv[1:] and not repair_hidden:
    sys.exit("bar-arrange-apply: --repair-hidden can only be combined with --check")

want = []  # (lane, id, hidden)
ws_id = ws_place = None
del_spacers = 0
del_ids = set()
for arg in sys.argv[1:]:
    if arg in ("--repair-hidden", "--check"):
        continue
    if arg.startswith("DEL:"):
        wid = arg[4:]
        if wid == "omarchy.spacer":
            # Spacer deletion, the mirror of minting — the panel sends one per removed
            # spacer, and the count is settled against the unnamed pool after ordering.
            del_spacers += 1
        else:
            # A plugin's uninstall: its entry leaves wherever it sits, lane or sidecar.
            del_ids.add(wid)
        continue
    if arg.startswith("WS:"):
        _, ws_id, ws_place = arg.split(":")
        if ws_place not in ("left", "center", "right"):
            sys.exit(f"bar-arrange-apply: bad WS placement '{ws_place}'")
        continue
    parts = arg.split(":")
    if parts[0] in ("L", "C", "R"):
        lane, wid = parts[0], parts[1]
        hid = len(parts) > 2 and parts[2] == "hidden"
    else:  # bare id — the pre-lane call form; those panels only knew the right section
        lane, wid = "R", parts[0]
        hid = len(parts) > 1 and parts[1] == "hidden"
    want.append((lane, wid, hid))

if repair_hidden and not os.path.exists(path):
    sys.exit(0)
with open(path) as f:
    data = json.load(f)
layout = data["bar"]["layout"]
LANES = ("L", "C", "R")
KEYS = {"L": "left", "C": "center", "R": "right"}
sections = {ln: layout.get(KEYS[ln], []) for ln in LANES}

def manifest_id(manifest):
    if not isinstance(manifest, dict) or manifest.get("schemaVersion") != 1 \
            or isinstance(manifest.get("schemaVersion"), bool):
        return None
    if any(key not in manifest for key in ("id", "name", "version", "kinds", "entryPoints")):
        return None
    wid = manifest["id"]
    kinds = manifest["kinds"]
    entry_points = manifest["entryPoints"]
    if isinstance(wid, bool) or not isinstance(wid, (str, int, float)):
        return None
    if isinstance(wid, float) and wid.is_integer():
        wid = int(wid)
    wid = str(wid)
    if not wid or "/" in wid or ".." in wid:
        return None
    if not isinstance(kinds, list) or not kinds or not isinstance(entry_points, dict):
        return None
    if any(not isinstance(value, str) or not value or value.startswith("/") or ".." in value
           for value in entry_points.values()):
        return None
    metadata = manifest.get("barWidget")
    if isinstance(metadata, dict) and "defaultSection" in metadata \
            and str(metadata["defaultSection"]) not in ("left", "center", "right"):
        return None
    return wid

def plugin_kinds_by_id():
    root = os.path.expanduser("~/.config/omarchy/plugins")
    try:
        names = sorted(name for name in os.listdir(root) if not name.startswith("."))
    except OSError:
        return {}
    found = {}
    for name in names:
        try:
            with open(os.path.join(root, name, "manifest.json")) as f:
                manifest = json.load(f)
        except (OSError, ValueError):
            continue
        wid = manifest_id(manifest)
        if wid is not None:
            found[wid] = manifest["kinds"]
    return found

parked_in = {ln: [] for ln in LANES}
if os.path.exists(side):
    with open(side) as f:
        sd = json.load(f)
    if repair_hidden:
        if not isinstance(sd, dict):
            sys.exit(0)
        rows = [sd.get(KEYS[ln], []) for ln in LANES]
        if any(not isinstance(lane, list) or any(not isinstance(row, dict)
               or not isinstance(row.get("entry"), dict) for row in lane) for lane in rows):
            sys.exit(0)
    for ln in LANES:
        parked_in[ln] = sd.get(KEYS[ln], [])

# Omarchy unloads a third-party service, panel or overlay when its last shell.json entry
# leaves the bar. Keep its id in plugins[] while its bar icon is parked. Repair mode brings
# already-hidden apps back too, and exits before any write when every entry is already right.
hidden_kinds = plugin_kinds_by_id() if repair_hidden or any(hid for _, _, hid in want) else {}
if repair_hidden:
    plugins = data.get("plugins", [])
    if not isinstance(plugins, list):
        sys.exit("bar-arrange-apply: 'plugins' is not a list")
    enabled = {item.get("id") for item in plugins if isinstance(item, dict)}
    visible = {entry.get("id") for ln in LANES for entry in sections[ln]}
    seen = set()
    want = []
    for ln in LANES:
        for row in parked_in[ln]:
            wid = (row.get("entry") or {}).get("id")
            if wid in seen or wid in enabled or wid in visible:
                continue
            seen.add(wid)
            if any(kind in hidden_kinds.get(wid, []) for kind in ("service", "panel", "overlay")):
                want.append((ln, wid, True))
    if not want:
        sys.exit(0)
    if repair_check:
        sys.exit(10)

# The workspaces strip moves whole, driven only by the WS directive — pull it out of
# every lane and the sidecar before anything else looks at the rows.
#
# ⚠️ ONLY WHEN IT IS CHANGING LANE. A strip already in the lane the panel asks for is left
# exactly where it stands, among the entries the panel never lists. It used to be pulled out
# and put back at the head of its lane, which on a stock Omarchy bar (left = the menu button,
# then the workspaces) moved the menu button out of the corner on the first Enter, with no bar
# change asked for. Found on a stock 4.0.4 machine, 2026-09-20.
ws_entry = None
ws_stays = False
if ws_id:
    for ln in LANES:
        if KEYS[ln] == ws_place and any(e.get("id") == ws_id for e in sections[ln]):
            ws_stays = True
if ws_id and not ws_stays:
    for ln in LANES:
        keep = []
        for e in sections[ln]:
            if e.get("id") == ws_id and ws_entry is None:
                ws_entry = e
            else:
                keep.append(e)
        sections[ln] = keep
        keep = []
        for row in parked_in[ln]:
            if (row.get("entry") or {}).get("id") == ws_id and ws_entry is None:
                ws_entry = row["entry"]
            else:
                keep.append(row)
        parked_in[ln] = keep
    if ws_entry is None:
        ws_entry = {"id": ws_id}

pools = {}
for ln in LANES:
    for entry in sections[ln]:
        pools.setdefault(entry["id"], []).append(entry)
    for row in parked_in[ln]:
        pools.setdefault(row["entry"]["id"], []).append(row["entry"])

ordered = {ln: [] for ln in LANES}
parked = {ln: [] for ln in LANES}
pos = {ln: 0 for ln in LANES}
for lane, wid, hid in want:
    pool = pools.get(wid)
    if pool:
        entry = pool.pop(0)
    elif wid == "omarchy.spacer":
        # Spacer instances are fungible, and Barbarian's "+ spacer" chip stages new
        # ones — the only widget this script will mint rather than refuse.
        entry = {"id": wid}
    else:
        sys.exit(f"bar-arrange-apply: '{wid}' is not in the bar or hidden list (or named twice)")
    if hid:
        if any(kind in hidden_kinds.get(wid, []) for kind in ("service", "panel", "overlay")):
            plugins = data.setdefault("plugins", [])
            if not isinstance(plugins, list):
                sys.exit("bar-arrange-apply: 'plugins' is not a list")
            if not any(isinstance(item, dict) and item.get("id") == wid for item in plugins):
                plugins.append({"id": wid})
        parked[lane].append({"index": pos[lane], "entry": entry})
    else:
        ordered[lane].append(entry)
    pos[lane] += 1

# Whatever was not named stays where it was: an unnamed VISIBLE entry keeps its lane,
# after the named ones; an unnamed HIDDEN entry stays parked in the sidecar. That second
# half was missing until 2026-09-01, and a caller that did not know about the sidecar
# (the pre-hide panel, still rendering out of a stale shell) silently destroyed the
# hidden Bluetooth entry through it.
# Deleted spacers: consume unnamed spacer entries from the pool so the leftover
# pass below drops them instead of preserving them. A deleted plugin id takes its
# every entry the same way; an id that names nothing is a caller's mistake, refused
# like any other unknown id rather than silently ignored.
deleted = []
configured_plugins = data.get("plugins", [])
if del_ids and not isinstance(configured_plugins, list):
    sys.exit("bar-arrange-apply: 'plugins' is not a list")
for wid in del_ids:
    pool = pools.pop(wid, None)
    has_plugin_entry = any(isinstance(item, dict) and item.get("id") == wid
                           for item in configured_plugins)
    if not pool and not has_plugin_entry:
        sys.exit(f"bar-arrange-apply: '{wid}' is not in the bar, hidden list or plugins[]")
    deleted.extend(pool or [])
    configured_plugins = [item for item in configured_plugins
                          if not isinstance(item, dict) or item.get("id") != wid]
if del_ids and "plugins" in data:
    data["plugins"] = configured_plugins
sp_pool = pools.get("omarchy.spacer") or []
for _ in range(del_spacers):
    if sp_pool:
        deleted.append(sp_pool.pop(0))

named = [e for ln in LANES for e in ordered[ln]] \
      + [r["entry"] for ln in LANES for r in parked[ln]]
for ln in LANES:
    leftovers = [e for e in sections[ln]
                 if not any(e is o for o in named) and not any(e is d for d in deleted)]
    lane_rows = ordered[ln] + leftovers
    if ws_id and not ws_stays and ws_place == KEYS[ln]:
        lane_rows = [ws_entry] + lane_rows
    layout[KEYS[ln]] = lane_rows
    for row in parked_in[ln]:
        if not any(row["entry"] is o for o in named) \
           and not any(row["entry"] is d for d in deleted):
            parked[ln].append({"index": row.get("index", 0), "entry": row["entry"]})

def write(p, obj):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix="." + os.path.basename(p) + ".")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(obj, f, indent=2)
            f.write("\n")
        os.replace(tmp, p)
    except BaseException:
        os.unlink(tmp)
        raise

write(path, data)
if not repair_hidden:
    write(side, {KEYS[ln]: parked[ln] for ln in LANES})
PY
