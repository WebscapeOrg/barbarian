#!/usr/bin/env python3
"""Caboodle's argv interface to the same Reptile settings the native panel uses."""

import json
from pathlib import Path
import sys

directory = Path(__file__).resolve().parent
if not (directory / "reptile_features.py").exists():
    directory = Path.home() / ".config/omarchy/workspace-layout"
sys.path.insert(0, str(directory))
import reptile_features as features


def main():
    arguments = sys.argv[1:]
    if len(arguments) != 2:
        raise features.SettingsError("Use reptile-feature status|on|off FEATURE.")
    action, key = arguments
    if action == "install-manifests":
        features.install_manifests(key)
        return
    if action in ("on", "off"):
        features.set_feature(key, action == "on")
    elif action != "status":
        raise features.SettingsError("Use reptile-feature status|on|off FEATURE.")
    print(json.dumps(features.status(key)))


if __name__ == "__main__":
    try:
        main()
    except (features.SettingsError, OSError) as error:
        sys.exit(str(error))
